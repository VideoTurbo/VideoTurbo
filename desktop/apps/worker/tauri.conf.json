{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoTurbo Worker",
  "identifier": "io.github.videoturbo.worker",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "VideoTurbo contributors",
    "copyright": "AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "让这台显卡电脑为 VideoTurbo 识别字幕",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../videoturbo/resources/ffmpeg/": "ffmpeg/",
      "../videoturbo/resources/worker-bundle/": "worker-bundle/",
      "../videoturbo/resources/uv/": "uv/",
      "../videoturbo/icons/tray.png": "icons/tray.png",
      "../../../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwOTJFQThBODlDMTY3OTEKUldTUlo4R0ppdXFTNEZYZTFOVThFa0Jhano5WG5tMGlGMDFvcEdVYUNxSnlIMDFlV0I2OHVXYjgK",
      "endpoints": [
        "https://github.com/VideoTurbo/VideoTurbo/releases/latest/download/latest-worker.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

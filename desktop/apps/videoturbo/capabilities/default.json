{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "外壳自己的页面（启动页、设置、本机识别）。控制台是主程序提供的网页，权限另见 console.json。",
  "windows": ["main", "settings", "worker"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "allow-server-state",
    "allow-restart-server",
    "allow-open-logs",
    "allow-get-settings",
    "allow-save-settings",
    "allow-worker-state",
    "allow-worker-set",
    "allow-worker-open-logs",
    "allow-worker-install-tools"
  ]
}

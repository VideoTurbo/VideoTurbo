{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoTurbo",
  "identifier": "io.github.videoturbo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "VideoTurbo contributors",
    "copyright": "AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "为影片库自动生成翻译字幕",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/server/": "server/",
      "resources/ffmpeg/": "ffmpeg/",
      "resources/worker-bundle/": "worker-bundle/",
      "icons/tray.png": "icons/tray.png",
      "../../../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}

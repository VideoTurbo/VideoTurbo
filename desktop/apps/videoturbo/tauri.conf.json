{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoTurbo",
  "identifier": "io.github.videoturbo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "publisher": "VideoTurbo contributors",
    "copyright": "AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "为影片库自动生成翻译字幕",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server/": "server/",
      "resources/ffmpeg/": "ffmpeg/",
      "resources/worker-bundle/": "worker-bundle/",
      "resources/uv/": "uv/",
      "icons/tray.png": "icons/tray.png",
      "../../../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwOTJFQThBODlDMTY3OTEKUldTUlo4R0ppdXFTNEZYZTFOVThFa0Jhano5WG5tMGlGMDFvcEdVYUNxSnlIMDFlV0I2OHVXYjgK",
      "endpoints": [
        "https://github.com/VideoTurbo/VideoTurbo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
